{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vthattey/twinrail/main/rule-packs/src/main/resources/schemas/rule-pack-1.schema.json",
  "title": "Twinrail rule pack, format 1",
  "description": "A versioned set of rules for one scheme or profile. See docs/rule-packs.md.",
  "type": "object",
  "required": ["format", "pack", "rules"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "pack": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "messageType": { "type": "string", "pattern": "^[a-z]{4}\\.[0-9]{3}\\.[0-9]{3}\\.[0-9]{2}$" },
    "reasonCode": { "type": "string", "pattern": "^[A-Z0-9]{2,4}$" },
    "rule": {
      "type": "object",
      "required": ["id", "message", "source", "assert", "reason", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "message": { "$ref": "#/$defs/messageType" },
        "source": {
          "type": "object",
          "description": "The public specification this rule comes from. Do not paste specification text.",
          "required": ["spec", "version"],
          "additionalProperties": false,
          "properties": {
            "spec": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "section": { "type": "string", "minLength": 1 }
          }
        },
        "when": { "type": "array", "items": { "$ref": "#/$defs/matcher" } },
        "assert": { "$ref": "#/$defs/matcher" },
        "reason": { "$ref": "#/$defs/reasonCode" },
        "text": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning"] }
      }
    },
    "matcher": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/((\\*|[A-Za-z_][A-Za-z0-9_.-]*)(\\[[1-9][0-9]{0,3}\\])?/)*((\\*|[A-Za-z_][A-Za-z0-9_.-]*)(\\[[1-9][0-9]{0,3}\\])?|@[A-Za-z_][A-Za-z0-9_.-]*)$"
        },
        "present": { "const": true },
        "absent": { "const": true },
        "equals": { "type": "string" },
        "notEquals": { "type": "string" },
        "oneOf": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "matches": { "type": "string" },
        "maxLength": { "type": "integer", "minimum": 0 },
        "minLength": { "type": "integer", "minimum": 0 },
        "min": { "type": ["integer", "string"] },
        "max": { "type": ["integer", "string"] }
      },
      "oneOf": [
        { "required": ["present"] },
        { "required": ["absent"] },
        { "required": ["equals"] },
        { "required": ["notEquals"] },
        { "required": ["oneOf"] },
        { "required": ["matches"] },
        { "required": ["maxLength"] },
        { "required": ["minLength"] },
        { "required": ["min"] },
        { "required": ["max"] }
      ]
    }
  }
}
